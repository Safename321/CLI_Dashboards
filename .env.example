# ─────────────────────────────────────────────────────────────────────────
# CLI Dashboards — SERVER environment (cli-proxy-server). NEVER prefixed VITE_.
# These are read ONLY by the proxy server, never bundled into client code (§3.5).
# Copy to `.env` for local dev; set as real env vars in production.
# ─────────────────────────────────────────────────────────────────────────

# --- Auth (§3.2, §3.3) ---
# Secret used to sign session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Session lifetime
JWT_TTL=12h

# Demo accounts: comma-separated email:bcryptHash pairs (§3.3).
# Generate a hash: node cli-proxy-server/config/hash-password.js 'YourPassword'
# Example (do NOT use in prod — set your own):
#   CLI_ACCOUNTS=admin@connectiveleadership.com:$2a$10$...,admin@snpglobal.com:$2a$10$...
CLI_ACCOUNTS=

# Set to "true" to run as a PUBLIC DEMO with auth fully disabled (no login screen).
# This is the honest fallback when no accounts are configured — never a decorative gate.
AUTH_DISABLED=false

# --- Chat proxy (§3.6) ---
# Anthropic API key — server-side only.
ANTHROPIC_API_KEY=
# Model for the AI mentor.
ANTHROPIC_MODEL=claude-sonnet-4-6
# When true, /api/chat requires a valid session JWT and FAILS CLOSED (401) otherwise.
CHAT_REQUIRE_AUTH=true

# --- CORS (§3.7) ---
# Comma-separated allow-list of origins permitted to call /api/auth and /api/chat.
# No wildcard. Example: http://localhost:5173,https://dashboards.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- External data APIs (server-side only) ---
FRED_API_KEY=
BLS_API_KEY=
ALPHAVANTAGE_API_KEY=
USPTO_API_KEY=

# Port for the local Express proxy server.
PORT=8787
